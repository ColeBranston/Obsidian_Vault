// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "11/30/2017 10:48:33"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    FullLabFile
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module FullLabFile_vlg_sample_tst(
	CLK_50MHz,
	SWITCH,
	sampler_tx
);
input  CLK_50MHz;
input  SWITCH;
output sampler_tx;

reg sample;
time current_time;
always @(CLK_50MHz or SWITCH)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module FullLabFile_vlg_check_tst (
	H0,
	H1,
	H2,
	H3,
	H4,
	H5,
	H6,
	sampler_rx
);
input  H0;
input  H1;
input  H2;
input  H3;
input  H4;
input  H5;
input  H6;
input sampler_rx;

reg  H0_expected;
reg  H1_expected;
reg  H2_expected;
reg  H3_expected;
reg  H4_expected;
reg  H5_expected;
reg  H6_expected;

reg  H0_prev;
reg  H1_prev;
reg  H2_prev;
reg  H3_prev;
reg  H4_prev;
reg  H5_prev;
reg  H6_prev;

reg  H0_expected_prev;
reg  H1_expected_prev;
reg  H2_expected_prev;
reg  H3_expected_prev;
reg  H4_expected_prev;
reg  H5_expected_prev;
reg  H6_expected_prev;

reg  last_H0_exp;
reg  last_H1_exp;
reg  last_H2_exp;
reg  last_H3_exp;
reg  last_H4_exp;
reg  last_H5_exp;
reg  last_H6_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:7] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 7'b1;
end

// update real /o prevs

always @(trigger)
begin
	H0_prev = H0;
	H1_prev = H1;
	H2_prev = H2;
	H3_prev = H3;
	H4_prev = H4;
	H5_prev = H5;
	H6_prev = H6;
end

// update expected /o prevs

always @(trigger)
begin
	H0_expected_prev = H0_expected;
	H1_expected_prev = H1_expected;
	H2_expected_prev = H2_expected;
	H3_expected_prev = H3_expected;
	H4_expected_prev = H4_expected;
	H5_expected_prev = H5_expected;
	H6_expected_prev = H6_expected;
end



// expected H0
initial
begin
	H0_expected = 1'bX;
	H0_expected = #999000 1'b0;
end 

// expected H1
initial
begin
	H1_expected = 1'bX;
	H1_expected = #999000 1'b0;
end 

// expected H2
initial
begin
	H2_expected = 1'bX;
	H2_expected = #999000 1'b0;
end 

// expected H3
initial
begin
	H3_expected = 1'bX;
	H3_expected = #999000 1'b0;
end 

// expected H4
initial
begin
	H4_expected = 1'bX;
	H4_expected = #999000 1'b0;
end 

// expected H5
initial
begin
	H5_expected = 1'bX;
	H5_expected = #999000 1'b0;
end 

// expected H6
initial
begin
	H6_expected = 1'bX;
	H6_expected = #999000 1'b0;
end 
// generate trigger
always @(H0_expected or H0 or H1_expected or H1 or H2_expected or H2 or H3_expected or H3 or H4_expected or H4 or H5_expected or H5 or H6_expected or H6)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected H0 = %b | expected H1 = %b | expected H2 = %b | expected H3 = %b | expected H4 = %b | expected H5 = %b | expected H6 = %b | ",H0_expected_prev,H1_expected_prev,H2_expected_prev,H3_expected_prev,H4_expected_prev,H5_expected_prev,H6_expected_prev);
	$display("| real H0 = %b | real H1 = %b | real H2 = %b | real H3 = %b | real H4 = %b | real H5 = %b | real H6 = %b | ",H0_prev,H1_prev,H2_prev,H3_prev,H4_prev,H5_prev,H6_prev);
`endif
	if (
		( H0_expected_prev !== 1'bx ) && ( H0_prev !== H0_expected_prev )
		&& ((H0_expected_prev !== last_H0_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port H0 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", H0_expected_prev);
		$display ("     Real value = %b", H0_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_H0_exp = H0_expected_prev;
	end
	if (
		( H1_expected_prev !== 1'bx ) && ( H1_prev !== H1_expected_prev )
		&& ((H1_expected_prev !== last_H1_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port H1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", H1_expected_prev);
		$display ("     Real value = %b", H1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_H1_exp = H1_expected_prev;
	end
	if (
		( H2_expected_prev !== 1'bx ) && ( H2_prev !== H2_expected_prev )
		&& ((H2_expected_prev !== last_H2_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port H2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", H2_expected_prev);
		$display ("     Real value = %b", H2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_H2_exp = H2_expected_prev;
	end
	if (
		( H3_expected_prev !== 1'bx ) && ( H3_prev !== H3_expected_prev )
		&& ((H3_expected_prev !== last_H3_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port H3 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", H3_expected_prev);
		$display ("     Real value = %b", H3_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_H3_exp = H3_expected_prev;
	end
	if (
		( H4_expected_prev !== 1'bx ) && ( H4_prev !== H4_expected_prev )
		&& ((H4_expected_prev !== last_H4_exp) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port H4 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", H4_expected_prev);
		$display ("     Real value = %b", H4_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_H4_exp = H4_expected_prev;
	end
	if (
		( H5_expected_prev !== 1'bx ) && ( H5_prev !== H5_expected_prev )
		&& ((H5_expected_prev !== last_H5_exp) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port H5 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", H5_expected_prev);
		$display ("     Real value = %b", H5_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_H5_exp = H5_expected_prev;
	end
	if (
		( H6_expected_prev !== 1'bx ) && ( H6_prev !== H6_expected_prev )
		&& ((H6_expected_prev !== last_H6_exp) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port H6 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", H6_expected_prev);
		$display ("     Real value = %b", H6_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_H6_exp = H6_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#3000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module FullLabFile_vlg_vec_tst();
// constants                                           
// general purpose registers
reg CLK_50MHz;
reg SWITCH;
// wires                                               
wire H0;
wire H1;
wire H2;
wire H3;
wire H4;
wire H5;
wire H6;

wire sampler;                             

// assign statements (if any)                          
FullLabFile i1 (
// port map - connection between master ports and signals/registers   
	.CLK_50MHz(CLK_50MHz),
	.H0(H0),
	.H1(H1),
	.H2(H2),
	.H3(H3),
	.H4(H4),
	.H5(H5),
	.H6(H6),
	.SWITCH(SWITCH)
);

// CLK_50MHz
always
begin
	CLK_50MHz = 1'b0;
	CLK_50MHz = #10000 1'b1;
	#10000;
end 

// SWITCH
initial
begin
	SWITCH = 1'b0;
	SWITCH = #140000 1'b1;
	SWITCH = #820000 1'b0;
	SWITCH = #240000 1'b1;
end 

FullLabFile_vlg_sample_tst tb_sample (
	.CLK_50MHz(CLK_50MHz),
	.SWITCH(SWITCH),
	.sampler_tx(sampler)
);

FullLabFile_vlg_check_tst tb_out(
	.H0(H0),
	.H1(H1),
	.H2(H2),
	.H3(H3),
	.H4(H4),
	.H5(H5),
	.H6(H6),
	.sampler_rx(sampler)
);
endmodule

